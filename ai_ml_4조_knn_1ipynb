","# 데이터 스케일링\n","scaler = StandardScaler()\n","X_train_scaled = scaler.fit_transform(X_train)\n","X_val_scaled = scaler.transform(X_val)\n","\n","# 3. Optuna로 최적의 n_neighbors 값 찾기\n","def objective(trial):\n","    n_neighbors = trial.suggest_int(\"n_neighbors\", 1, 50)\n","    knn_model = KNeighborsRegressor(n_neighbors=n_neighbors)\n","    knn_model.fit(X_train_scaled, y_train)\n","    y_val_pred = knn_model.predict(X_val_scaled)\n","    rmse = np.sqrt(mean_squared_error(y_val, y_val_pred))\n","    return rmse\n","\n","study = optuna.create_study(direction=\"minimize\")\n","study.optimize(objective, n_trials=50)\n","\n","optimal_k = study.best_params[\"n_neighbors\"]\n","optimal_rmse = study.best_value\n","\n","k_values = [trial.params[\"n_neighbors\"] for trial in study.trials if trial.value is not None]\n","rmse_values = [trial.value for trial in study.trials if trial.value is not None]\n","\n","print(f\"Optimal n_neighbors: {optimal_k}, Validation RMSE: {optimal_rmse:.2f}\")\n","\n","# 4. 테스트 데이터 전처리 및 예측\n","X_test = test_merged[features3]\n","X_test_scaled = scaler.transform(X_test)  # 테스트 데이터 스케일링\n","\n","# 최적의 n_neighbors로 모델 재학습\n","final_model = KNeighborsRegressor(n_neighbors=optimal_k)\n","final_model.fit(X_train_scaled, y_train)\n","\n","# 테스트 데이터 예측\n","y_pred = final_model.predict(X_test_scaled)\n","\n","\n","plt.figure(figsize=(10, 6))\n","plt.scatter(k_values, rmse_values, alpha=0.6, edgecolors=\"k\", label=\"Optuna Trials\")\n","plt.axvline(optimal_k, color=\"red\", linestyle=\"--\", label=f\"Optimal k = {optimal_k}\")\n","plt.title(\"Optuna Trials: n_neighbors vs Validation RMSE\")\n","plt.xlabel(\"n_neighbors\")\n","plt.ylabel(\"Validation RMSE\")\n","plt.legend()\n","plt.grid(True)\n","plt.show()\n","\n","\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"QqEOipD3rRHZ","executionInfo":{"status":"ok","timestamp":1732259746187,"user_tz":-540,"elapsed":196327,"user":{"displayName":"한동희","userId":"04305375498573130