aled)\n","    rmse = np.sqrt(mean_squared_error(y_val, y_val_pred))\n","    return rmse\n","\n","study = optuna.create_study(direction=\"minimize\")\n","study.optimize(objective, n_trials=50)\n","\n","optimal_k = study.best_params[\"n_neighbors\"]\n","optimal_rmse = study.best_value\n","\n","print(f\"Optimal n_neighbors: {optimal_k}, Validation RMSE: {optimal_rmse:.2f}\")\n","\n","# 4. 테스트 데이터 전처리 및 예측\n","X_test = test_merged[features2]\n","X_test_scaled = scaler.transform(X_test)  # 테스트 데이터 스케일링\n","\n","# 최적의 n_neighbors로 모델 재학습\n","final_model = KNeighborsRegressor(n_neighbors=optimal_k)\n","final_model.fit(X_train_scaled, y_train)\n","\n","# 테스트 데이터 예측\n","y_pred = final_model.predict(X_test_scaled)\n","\n","\n","plt.figure(figsize=(10, 6))\n","plt.scatter(k_values, rmse_values, alpha=0.6, edgecolors=\"k\", label=\"Optuna Trials\")\n","plt.axvline(optimal_k, color=\"red\", linestyle=\"--\", label=f\"Optimal k = {optimal_k}\")\n","plt.title(\"Optuna Trials: n_neighbors vs Validation RMSE\")\n","plt.xlabel(\"n_neighbors\")\n","plt.ylabel(\"Validation RMSE\")\n","plt.legend()\n","plt.grid(True)\n","plt.show()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"JJcJVyusvfas","executionInfo":{"status":"ok","timestamp":1732193086100,"user_tz":-540,"elapsed":26939,"user":{"displayName":"한동희","userId":"04305375498573130397"}},"outputId":"3a512440-ce38-4040-b035-9d21c4e86e62"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stderr","text":["[I 2024-11-21 12:44:18,636] A new study created in memory with name: no-name-e13930c0-e8e8-461c-8c55-6342881464ac\n","[I 2024-11-21 12:44:18,986] Trial 0 finished with value: 1512.2439928802908 and parameters: {'n_neighbors': 4}. Best is trial 0 with value: 1512.2439928802908.\n","[I 2024-11-21 12:44:19,337] Trial 1 finished with value: 1682.9037717112844 and parameters: {'n_neighbors': 2}. Best is trial 0 with value: 1512.2439928802908.\n","[I 2024-11-21 12:44:19,775] Trial 2 finished